# DisasterGraph AI — environment configuration
# Copy this file to .env and fill in real values as needed.
# Do NOT commit a real .env file with secrets.

# --- General ---
# When true, the app auto-seeds demo data, uses the in-memory graph and
# TF-IDF vector fallback if Neo4j/Chroma aren't configured, and uses
# deterministic Demo Mode answers if no LLM API key is set.
DEMO_MODE=true

# --- LLM (OpenAI-compatible endpoint) ---
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# --- Neo4j (optional; falls back to in-memory graph if not reachable) ---
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# --- ChromaDB (optional; falls back to TF-IDF if chromadb isn't installed) ---
CHROMA_PATH=./data/chroma_store

# --- Database ---
DATABASE_URL=sqlite:///./data/app.db

# --- CORS (comma-separated origins allowed to call the API) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=20
